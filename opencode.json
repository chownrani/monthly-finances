{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "build",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "edit": "allow",
    "read": "allow",
    "webfetch": "ask",
    "external_directory": {
      "*": "ask",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/gh/**": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git commit*": "ask",
      "git reset --hard*": "deny",
      "*git reset --hard*": "deny",
      "git clean -f*": "deny",
      "*git clean -f*": "deny",
      "*--no-verify*": "deny",
      "*git push*--force*": "deny",
      "*git push* -f*": "deny",
      "rm -rf*": "deny",
      "*rm -rf*": "deny",
      "sudo *": "deny",
      "* sudo *": "deny",
      "chmod -R 777*": "deny",
      "*chmod -R 777*": "deny",
      "*| sh": "deny",
      "*| bash": "deny",
      "*|sh": "deny",
      "*|bash": "deny"
    }
  }
}
